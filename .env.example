# dili 后端配置模板（只含占位符；真实值放在仓库外受保护文件，如 /etc/dili/dili.env，权限 640 root:dili）
# 生产环境请勿把真实 .env 提交到 Git。

# ---- 监听与目录 ----
HOST=127.0.0.1
PORT=13104
DATA_DIR=backend/data
ASSET_DIR=backend/public/assets

# ---- 腾讯位置服务（本次迁移不改） ----
TENCENT_MAP_KEY=

# ---- 视觉识别 / 故事生成（OPENAI_*，与文字问答互不影响；当前与问答同用 TokenHub deepseek/deepseek-flash，同一个 Key） ----
OPENAI_BASE_URL=https://tokenhub.tencentmaas.com
OPENAI_CHAT_COMPLETIONS_PATH=/v1/chat/completions
OPENAI_API_KEY=
OPENAI_MODEL=deepseek/deepseek-flash
OPENAI_VISION_MODEL=deepseek/deepseek-flash
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_TOKENS=600

# ---- 文字问答（ASSISTANT_*，未填时回退 OPENAI_*） ----
ASSISTANT_BASE_URL=https://tokenhub.tencentmaas.com
ASSISTANT_CHAT_COMPLETIONS_PATH=/v1/chat/completions
ASSISTANT_API_KEY=
ASSISTANT_MODEL=deepseek/deepseek-flash
ASSISTANT_TIMEOUT_MS=30000
ASSISTANT_MAX_TOKENS=2000

# ---- 语音识别 ----
# tencent：腾讯云一句话识别 SentenceRecognition（默认）
# openai-compatible：回滚到旧的本地 Qwen3-ASR（转发到 SPEECH_TO_TEXT_URL）
SPEECH_TO_TEXT_PROVIDER=tencent
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 仅使用临时凭证时填写（会过期）
TENCENTCLOUD_SESSION_TOKEN=
TENCENT_ASR_ENGINE=16k_zh
TENCENT_ASR_ENDPOINT=asr.tencentcloudapi.com
ASR_TIMEOUT_MS=15000
ASR_MAX_RETRIES=1
# 回滚模式使用
SPEECH_TO_TEXT_URL=http://127.0.0.1:3102/v1/audio/transcriptions
SPEECH_TO_TEXT_TIMEOUT_MS=60000

# ---- 付费接口保护（语音/视觉/问答） ----
PAID_RATE_LIMIT_PER_MINUTE=20
PAID_MAX_CONCURRENCY=4
# 位于 Nginx 之后时为 1（按 X-Real-IP 限流）
TRUST_PROXY=1

# ---- 管理自检接口 /api/admin/check（≥16 位随机串；留空则接口关闭） ----
ADMIN_TOKEN=
