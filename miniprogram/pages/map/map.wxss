.map-page {
  min-height: 100vh;
  background: #f6f4ef;
}

.map {
  width: 100%;
  height: 58vh;
}

.sheet {
  padding: 24rpx;
  background: #ffffff;
  border-top: 1rpx solid #e4e0d8;
}

.place-list {
  height: 34vh;
  margin-top: 18rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece8df;
}

.row-title {
  font-size: 29rpx;
  font-weight: 650;
  color: #18212f;
}
