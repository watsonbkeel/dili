<view class="map-page">
  <map
    class="map"
    latitude="{{latitude}}"
    longitude="{{longitude}}"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
  />
  <view class="sheet">
    <view class="card-title">北京历史热点</view>
    <view wx:if="{{loading}}" class="meta">正在加载地图热点...</view>
    <view wx:if="{{error}}" class="meta">{{error}}</view>
    <scroll-view scroll-y class="place-list">
      <block wx:for="{{places}}" wx:key="id">
        <view class="row" bindtap="openPlace" data-id="{{item.id}}">
          <view>
            <view class="row-title">{{item.name}}</view>
            <view class="meta">{{item.address || '暂无地址'}}</view>
          </view>
          <text class="tag">{{item.categoryText}}</text>
        </view>
      </block>
    </scroll-view>
  </view>
  <view class="ai-float" bindtap="openAi">AI</view>
  <view class="bottom-nav">
    <view class="nav-item" data-tab="home" bindtap="goTab"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item active" data-tab="map" bindtap="goTab"><view class="nav-icon">◎</view><view>地图</view></view>
    <view class="nav-item" data-tab="routes" bindtap="goTab"><view class="nav-icon">⌘</view><view>路线</view></view>
    <view class="nav-item" data-tab="favorites" bindtap="goTab"><view class="nav-icon">♡</view><view>收藏</view></view>
    <view class="nav-item" data-tab="profile" bindtap="goTab"><view class="nav-icon">○</view><view>我的</view></view>
  </view>
</view>
