.route-card {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border: 1rpx solid #e4e0d8;
  border-radius: 8rpx;
  background: #ffffff;
}

.route-hero {
  min-height: 220rpx;
  border-radius: 8rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-end;
  background: linear-gradient(135deg, #1f6f68, #c7954a);
  color: #ffffff;
  box-sizing: border-box;
}

.route-title {
  font-size: 38rpx;
  font-weight: 800;
}

.route-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.route-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.tag-wrap {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

.stop-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece8df;
}

.stop-order {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #15937f;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.stop-main {
  flex: 1;
  min-width: 0;
}

.stop-name {
  color: #18212f;
  font-size: 29rpx;
  font-weight: 700;
}

.toolbar {
  margin-top: 22rpx;
}
