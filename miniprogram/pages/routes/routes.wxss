.route-card {
  margin-bottom: 28rpx;
  padding: 24rpx;
  border: 1rpx solid #e4e0d8;
  border-radius: 8rpx;
  background: #ffffff;
}

.route-hero {
  min-height: 220rpx;
  border-radius: 8rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-end;
  background: linear-gradient(135deg, #1f6f68, #c7954a);
  color: #ffffff;
  box-sizing: border-box;
}

.route-title {
  font-size: 38rpx;
  font-weight: 800;
}

.route-desc {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.route-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.tag-wrap {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin: 20rpx 0;
}

.stop-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece8df;
}

.stop-order {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #15937f;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.stop-main {
  flex: 1;
  min-width: 0;
}

.stop-name {
  color: #18212f;
  font-size: 29rpx;
  font-weight: 700;
}

.toolbar {
  margin-top: 22rpx;
}

.route-mode-note {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 8rpx;
  background: #edf4f2;
  color: #1f6f68;
  font-size: 26rpx;
  line-height: 1.45;
}

.route-low-vision {
  background: #ffffff;
  color: #000000;
}

.route-low-vision .title {
  color: #000000;
  font-size: 56rpx;
  font-weight: 900;
}

.route-low-vision .subtitle,
.route-low-vision .route-desc,
.route-low-vision .route-meta,
.route-low-vision .meta {
  color: #000000;
  font-size: 34rpx;
  line-height: 1.45;
}

.route-low-vision .route-mode-note,
.route-low-vision .route-card {
  border: 4rpx solid #000000;
  background: #ffffff;
  color: #000000;
}

.route-low-vision .route-hero {
  min-height: 190rpx;
  border: 4rpx solid #000000;
  background: #000000;
  color: #ffffff;
}

.route-low-vision .route-title {
  font-size: 44rpx;
}

.route-low-vision .stop-row {
  min-height: 104rpx;
  border-bottom: 3rpx solid #000000;
}

.route-low-vision .stop-name {
  color: #000000;
  font-size: 36rpx;
}

.route-low-vision .btn {
  min-height: 86rpx;
  border: 4rpx solid #000000;
  color: #000000;
  background: #ffffff;
  font-size: 32rpx;
  font-weight: 900;
}

.route-low-vision .btn.primary {
  color: #ffffff;
  background: #000000;
}

.route-mobility .route-mode-note {
  background: #e5f7ef;
  border: 1rpx solid #c5ead9;
  color: #127653;
}

.route-mobility .route-card {
  border-color: #e2efe7;
  border-radius: 18rpx;
  box-shadow: 0 10rpx 28rpx rgba(41, 86, 68, 0.08);
}

.route-mobility .route-hero {
  background: #edf8f2;
  color: #0f6e52;
}

.route-mobility .stop-order {
  background: #0f8b66;
}
