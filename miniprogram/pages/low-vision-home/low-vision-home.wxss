page {
  width: 100%;
  background: #ffffff;
  overflow-x: hidden;
}

.lv-page {
  width: 100%;
  min-height: 100vh;
  padding: 0 30rpx calc(430rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #ffffff;
  color: #000000;
  font-size: 44rpx;
  line-height: 1.55;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  overflow-x: hidden;
}

.lv-fixed-header {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  padding-left: 30rpx;
  padding-right: 30rpx;
  border-bottom: 4rpx solid #000000;
  background: #ffffff;
  box-sizing: border-box;
}

.lv-top-row {
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.lv-header-placeholder {
  width: 100%;
}

.lv-title {
  color: #000000;
  font-size: 68rpx;
  line-height: 1.15;
  font-weight: 900;
}

.lv-mode-switch {
  min-width: 220rpx;
  min-height: 94rpx;
  padding: 0 16rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
  font-size: 40rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.lv-font-panel {
  margin-top: 28rpx;
  padding: 22rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
}

.lv-font-prompt {
  font-size: 46rpx;
  line-height: 1.45;
  font-weight: 900;
}

.lv-font-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.lv-font-option {
  min-width: 0;
  height: 92rpx;
  min-height: 92rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
  font-size: 44rpx;
  line-height: 88rpx;
  font-weight: 900;
}

.lv-font-option::after {
  border: 0;
}

.lv-font-option.selected {
  background: #000000;
  color: #ffffff;
}

.lv-city {
  margin-top: 28rpx;
  color: #000000;
  font-size: 62rpx;
  line-height: 1.2;
  font-weight: 900;
  white-space: nowrap;
}

.lv-card,
.lv-place,
.lv-nearby-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
}

.lv-card {
  font-size: 44rpx;
  line-height: 1.55;
  font-weight: 800;
}

.lv-voice-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 25;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 4rpx solid #000000;
  background: #ffffff;
  color: #000000;
  box-sizing: border-box;
}

.lv-listen-title,
.lv-section-title {
  color: #000000;
  font-size: 54rpx;
  line-height: 1.25;
  font-weight: 900;
}

.lv-voice-dock .lv-listen-title {
  font-size: 48rpx;
  line-height: 1.2;
}

.lv-section-title {
  margin-top: 44rpx;
}

.lv-listen-state {
  margin-top: 8rpx;
  color: #000000;
  font-size: 40rpx;
  line-height: 1.45;
  font-weight: 800;
}

.lv-search-query {
  margin-top: 16rpx;
  color: #000000;
  font-size: 44rpx;
  line-height: 1.45;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.lv-listen-actions {
  margin-top: 14rpx;
}

.lv-main-btn,
.lv-big-btn {
  min-height: 112rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  color: #000000;
  background: #ffffff;
  font-size: 50rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lv-main-btn {
  width: 100%;
  min-height: 104rpx;
  background: #000000;
  color: #ffffff;
}

.lv-main-btn.is-processing {
  background: #555555;
}

.lv-search-results {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
}

.lv-search-result-title {
  padding-top: 20rpx;
  color: #000000;
  font-size: 52rpx;
  line-height: 1.3;
  font-weight: 900;
}

.lv-search-result {
  padding: 28rpx 0;
  border-bottom: 2rpx solid #000000;
  background: #ffffff;
  color: #000000;
}

.lv-search-result:last-child {
  border-bottom: 0;
}

.lv-place-name {
  color: #000000;
  font-size: 58rpx;
  line-height: 1.3;
  font-weight: 900;
}

.lv-summary,
.lv-distance {
  margin-top: 18rpx;
  color: #000000;
  font-size: 46rpx;
  line-height: 1.6;
  font-weight: 700;
}

.lv-place-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.font-small {
  font-size: 38rpx;
}

.font-small .lv-title { font-size: 56rpx; }
.font-small .lv-mode-switch { font-size: 34rpx; }
.font-small .lv-font-prompt { font-size: 38rpx; }
.font-small .lv-font-option { font-size: 36rpx; }
.font-small .lv-city { font-size: 50rpx; }
.font-small .lv-card { font-size: 38rpx; }
.font-small .lv-listen-title,
.font-small .lv-section-title { font-size: 46rpx; }
.font-small .lv-voice-dock .lv-listen-title { font-size: 42rpx; }
.font-small .lv-listen-state { font-size: 34rpx; }
.font-small .lv-search-query { font-size: 38rpx; }
.font-small .lv-main-btn,
.font-small .lv-big-btn { font-size: 42rpx; }
.font-small .lv-search-result-title { font-size: 44rpx; }
.font-small .lv-place-name { font-size: 50rpx; }
.font-small .lv-summary,
.font-small .lv-distance { font-size: 38rpx; }

.font-medium {
  font-size: 42rpx;
}

.font-medium .lv-title { font-size: 62rpx; }
.font-medium .lv-mode-switch { font-size: 37rpx; }
.font-medium .lv-font-prompt { font-size: 42rpx; }
.font-medium .lv-font-option { font-size: 40rpx; }
.font-medium .lv-city { font-size: 56rpx; }
.font-medium .lv-card { font-size: 42rpx; }
.font-medium .lv-listen-title,
.font-medium .lv-section-title { font-size: 50rpx; }
.font-medium .lv-voice-dock .lv-listen-title { font-size: 45rpx; }
.font-medium .lv-listen-state { font-size: 37rpx; }
.font-medium .lv-search-query { font-size: 41rpx; }
.font-medium .lv-main-btn,
.font-medium .lv-big-btn { font-size: 46rpx; }
.font-medium .lv-search-result-title { font-size: 48rpx; }
.font-medium .lv-place-name { font-size: 54rpx; }
.font-medium .lv-summary,
.font-medium .lv-distance { font-size: 42rpx; }

.font-large {
  font-size: 46rpx;
}
