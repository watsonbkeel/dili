.lv-page {
  min-height: 100vh;
  background: #ffffff;
  color: #000000;
  padding: 92rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.lv-mode-switch {
  min-height: 96rpx;
  border: 5rpx solid #000000;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 34rpx;
  font-size: 42rpx;
  font-weight: 900;
  background: #000000;
  color: #ffffff;
}

.lv-title {
  text-align: center;
  font-size: 58rpx;
  line-height: 1.2;
  font-weight: 900;
  margin-bottom: 42rpx;
}

.lv-status {
  padding: 24rpx 26rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
  color: #000000;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.35;
  margin-bottom: 34rpx;
}

.lv-actions {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.lv-action {
  min-height: 142rpx;
  border: 6rpx solid #000000;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36rpx;
  box-sizing: border-box;
  font-size: 60rpx;
  font-weight: 900;
}

.lv-listen-panel {
  margin-top: 34rpx;
  border: 5rpx solid #000000;
  border-radius: 14rpx;
  padding: 28rpx;
  background: #ffffff;
}

.lv-listen-title {
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 900;
}

.lv-listen-state {
  margin-top: 18rpx;
  font-size: 38rpx;
  line-height: 1.45;
  font-weight: 800;
}

.lv-listen-stop {
  min-height: 96rpx;
  margin-top: 24rpx;
  border: 5rpx solid #000000;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
}

.lv-action text {
  font-size: 78rpx;
}

.lv-section-title {
  margin: 64rpx 0 24rpx;
  font-size: 46rpx;
  font-weight: 900;
}

.lv-card,
.lv-place {
  border: 4rpx solid #d8d8d8;
  border-radius: 24rpx;
  padding: 34rpx;
  margin-bottom: 28rpx;
  color: #000000;
  background: #ffffff;
}

.lv-place-name {
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.15;
}

.lv-distance {
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 800;
}

.lv-summary {
  margin-top: 24rpx;
  font-size: 40rpx;
  line-height: 1.45;
}

.lv-place-actions {
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 4rpx solid #e3e3e3;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.lv-big-btn {
  min-height: 96rpx;
  border: 5rpx solid #000000;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  font-weight: 900;
}
