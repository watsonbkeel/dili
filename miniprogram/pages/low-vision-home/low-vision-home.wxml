<view class="lv-page font-{{fontSize}}">
  <view class="lv-fixed-header" style="padding-top: {{headerTopPadding}}px;">
    <view class="lv-top-row">
      <view class="lv-title">语音大字导览</view>
      <view class="lv-mode-switch" bindtap="changeMode">切换模式</view>
    </view>
  </view>
  <view class="lv-header-placeholder" style="height: {{headerHeight}}px;"></view>

  <view class="lv-font-panel">
    <view class="lv-font-prompt">请选择你的文字大小</view>
    <view class="lv-font-options">
      <button class="lv-font-option {{fontSize === 'small' ? 'selected' : ''}}" bindtap="changeFontSize" data-size="small" aria-label="使用小号文字">小</button>
      <button class="lv-font-option {{fontSize === 'medium' ? 'selected' : ''}}" bindtap="changeFontSize" data-size="medium" aria-label="使用中号文字">中</button>
      <button class="lv-font-option {{fontSize === 'large' ? 'selected' : ''}}" bindtap="changeFontSize" data-size="large" aria-label="使用大号文字">大</button>
    </view>
  </view>
  <view class="lv-city">城市：北京</view>

  <view wx:if="{{searchQuery || searchResults.length}}" id="voice-search-results" class="lv-search-results">
    <view wx:if="{{searchQuery}}" class="lv-search-query">你说：{{searchQuery}}</view>
    <view wx:if="{{searchAnswer}}" class="lv-search-answer">{{searchAnswer}}</view>
    <view wx:if="{{searchResultTitle}}" class="lv-search-result-title">{{searchResultTitle}}</view>
    <block wx:for="{{searchResults}}" wx:key="id">
      <view class="lv-search-result" bindtap="openPlace" data-id="{{item.id}}">
        <view class="lv-place-name">{{item.name}}</view>
        <view class="lv-summary">{{item.briefSummary}}</view>
      </view>
    </block>
  </view>

  <view class="lv-section-title">全部景点列表</view>
  <view wx:if="{{loading}}" class="lv-card">正在加载景点</view>
  <view wx:elif="{{error}}" class="lv-card">{{error}}</view>
  <view wx:elif="{{!visiblePlaces.length}}" class="lv-card">暂无景点</view>
  <block wx:else>
    <block wx:for="{{visiblePlaces}}" wx:key="id">
      <view class="lv-place" bindtap="openPlace" data-id="{{item.id}}">
        <view class="lv-place-name">{{item.name}}</view>
        <view class="lv-summary">{{item.briefSummary}}</view>
        <view class="lv-place-actions">
          <view class="lv-big-btn" catchtap="playIntro" data-id="{{item.id}}">听介绍</view>
          <view class="lv-big-btn" catchtap="openNavigation" data-id="{{item.id}}">导航</view>
        </view>
      </view>
    </block>
  </block>

  <view class="lv-section-title">附近景点</view>
  <view wx:if="{{nearbyPlace}}" class="lv-nearby-card" bindtap="openPlace" data-id="{{nearbyPlace.id}}">
    <view class="lv-place-name">{{nearbyPlace.name}}</view>
    <view class="lv-distance">{{nearbyPlace.distanceText}} · {{nearbyPlace.routeNote}}</view>
  </view>

  <view class="lv-voice-dock">
    <view class="lv-listen-title">语音搜索</view>
    <view class="lv-listen-state">{{searchStatus}}</view>
    <view class="lv-listen-actions">
      <view class="lv-main-btn {{processing ? 'is-processing' : ''}}" bindtap="toggleVoiceSearch">
        <text wx:if="{{recording}}">停止</text>
        <text wx:elif="{{processing}}">处理中</text>
        <text wx:else>开始</text>
      </view>
    </view>
  </view>
</view>
