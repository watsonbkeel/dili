.mh-page {
  min-height: 100vh;
  padding: 56rpx 28rpx 180rpx;
  box-sizing: border-box;
  background: #f3f7f5;
  color: #18212f;
}

.mh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.mh-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #075f3e;
  line-height: 1.2;
}

.mh-mode-switch {
  min-width: 150rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border: 1rpx solid #168761;
  border-radius: 8rpx;
  background: #ffffff;
  color: #168761;
  font-size: 25rpx;
  flex-shrink: 0;
}

.mh-mode-switch::after,
.refresh::after,
.section-more::after,
.outline-btn::after,
.solid-btn::after,
.retry-btn::after {
  border: 0;
}

.mh-status {
  min-height: 72rpx;
  padding: 0 22rpx;
  border: 1rpx solid #c5ead9;
  border-radius: 8rpx;
  background: #e5f7ef;
  color: #127653;
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 27rpx;
  margin-bottom: 24rpx;
}

.mh-status-icon {
  font-size: 30rpx;
  font-weight: 900;
}

.mh-map-card {
  overflow: hidden;
  margin-bottom: 24rpx;
  border: 1rpx solid #dce8e2;
  border-radius: 8rpx;
  background: #ffffff;
}

.mh-map {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #e6ece9;
}

.mh-map-caption {
  min-height: 64rpx;
  padding: 0 18rpx;
  color: #52616c;
  font-size: 23rpx;
  display: flex;
  align-items: center;
}

.mh-feature-grid {
  display: flex;
  align-items: stretch;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.mh-feature {
  width: 0;
  min-width: 0;
  min-height: 220rpx;
  padding: 22rpx 14rpx;
  flex: 1;
  border: 1rpx solid #d7e5df;
  border-radius: 8rpx;
  box-sizing: border-box;
  text-align: center;
}

.mh-feature.green {
  background: #dff5e9;
}

.mh-feature.blue {
  background: #e7f0fb;
  border-color: #d1e0f2;
}

.mh-feature.neutral {
  background: #fff4dc;
  border-color: #eadcbb;
}

.mh-feature-icon {
  height: 52rpx;
  color: #126747;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.mh-feature-title {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
}

.mh-feature-desc {
  margin-top: 10rpx;
  color: #4f5e66;
  font-size: 22rpx;
  line-height: 1.4;
}

.location-card {
  min-height: 112rpx;
  padding: 22rpx;
  border: 1rpx solid #dce8e2;
  border-radius: 8rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.location-copy {
  min-width: 0;
  flex: 1;
}

.location-main {
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.4;
}

.location-sub,
.section-sub,
.place-meta {
  margin-top: 8rpx;
  color: #667085;
  font-size: 24rpx;
  line-height: 1.45;
}

.refresh {
  min-width: 146rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 14rpx;
  border: 1rpx solid #168761;
  border-radius: 8rpx;
  background: #ffffff;
  color: #168761;
  font-size: 25rpx;
  flex-shrink: 0;
}

.place-section {
  margin-bottom: 38rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-more {
  min-width: 132rpx;
  min-height: 58rpx;
  line-height: 58rpx;
  padding: 0 12rpx;
  border: 0;
  background: transparent;
  color: #137858;
  font-size: 25rpx;
  flex-shrink: 0;
}

.place-list {
  display: grid;
  gap: 18rpx;
}

.place-card {
  overflow: hidden;
  border: 1rpx solid #dce8e2;
  border-radius: 8rpx;
  background: #ffffff;
}

.place-image {
  width: 100%;
  height: 250rpx;
  display: block;
  background: #e6ece9;
}

.place-main {
  padding: 22rpx;
}

.place-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.place-name {
  min-width: 0;
  color: #18212f;
  font-size: 33rpx;
  font-weight: 800;
  line-height: 1.3;
}

.access-badge,
.recommend-badge {
  max-width: 270rpx;
  padding: 7rpx 12rpx;
  border-radius: 6rpx;
  background: #fff0d8;
  color: #9a4f0c;
  font-size: 21rpx;
  line-height: 1.35;
  text-align: center;
  flex-shrink: 0;
}

.access-badge.full {
  background: #dff5e9;
  color: #0d724e;
}

.recommend-badge {
  background: #e8f0ff;
  color: #285fae;
}

.place-summary {
  margin-top: 14rpx;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.6;
}

.access-line {
  margin-top: 12rpx;
  color: #137858;
  font-size: 24rpx;
  font-weight: 700;
}

.place-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 20rpx;
}

.outline-btn,
.solid-btn {
  min-height: 72rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outline-btn {
  border: 1rpx solid #168761;
  background: #ffffff;
  color: #168761;
}

.solid-btn {
  border: 1rpx solid #0f7b5c;
  background: #0f7b5c;
  color: #ffffff;
}

.mh-state {
  padding: 26rpx;
  border: 1rpx solid #dce8e2;
  border-radius: 8rpx;
  background: #ffffff;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.error-state {
  color: #9b3c31;
}

.retry-btn {
  width: 240rpx;
  height: 68rpx;
  line-height: 68rpx;
  margin-top: 18rpx;
  border: 1rpx solid #168761;
  border-radius: 8rpx;
  background: #ffffff;
  color: #168761;
  font-size: 25rpx;
}

.risk-band {
  padding: 22rpx 0;
  border-top: 1rpx solid #e4caa9;
  border-bottom: 1rpx solid #e4caa9;
  color: #8a460e;
  font-size: 25rpx;
  line-height: 1.55;
}

.risk-title {
  margin-bottom: 8rpx;
  font-size: 29rpx;
  font-weight: 800;
}

@media (max-width: 360px) {
  .place-title-row,
  .location-card {
    align-items: stretch;
    flex-direction: column;
  }

  .access-badge,
  .recommend-badge {
    max-width: 100%;
    align-self: flex-start;
  }
}
