.mh-page {
  min-height: 100vh;
  padding: 56rpx 28rpx 150rpx;
  box-sizing: border-box;
  background: #eefaf5;
  color: #18212f;
}

.mh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 28rpx;
}

.mh-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #075f3e;
  line-height: 1.2;
}

.mh-mode-switch {
  min-width: 150rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #168761;
  background: #ffffff;
  color: #168761;
  font-size: 25rpx;
  flex-shrink: 0;
}

.mh-mode-switch::after {
  border: 0;
}

.mh-status {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #e5f7ef;
  border: 1rpx solid #c5ead9;
  color: #127653;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 27rpx;
  margin-bottom: 28rpx;
}

.mh-feature-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.mh-feature {
  min-height: 236rpx;
  border-radius: 22rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-sizing: border-box;
}

.mh-feature.green {
  background: linear-gradient(135deg, #65d7b5, #a5efd9);
}

.mh-feature.blue {
  background: linear-gradient(135deg, #91c4ff, #c4defe);
}

.mh-feature.purple {
  background: linear-gradient(135deg, #b496ef, #d7c7ff);
}

.mh-feature-icon {
  height: 54rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #126747;
}

.mh-feature-title {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.25;
}

.mh-feature-desc {
  margin-top: 12rpx;
  color: #4f5e66;
  font-size: 23rpx;
  line-height: 1.35;
}

.mh-feature-arrow {
  margin: 18rpx auto 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 23rpx;
  background: #ffffff;
  color: #228a65;
  font-size: 42rpx;
  line-height: 40rpx;
}

.location-card,
.section-card,
.info-card,
.risk-card {
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 10rpx 28rpx rgba(41, 86, 68, 0.08);
  border: 1rpx solid #e4efe9;
}

.location-card {
  min-height: 112rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.location-main {
  font-size: 29rpx;
  font-weight: 700;
}

.location-sub,
.mh-meta {
  margin-top: 8rpx;
  color: #6c7474;
  font-size: 24rpx;
  line-height: 1.45;
}

.refresh {
  color: #168761;
  font-size: 27rpx;
  flex-shrink: 0;
}

.section-card {
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 22rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.section-more {
  color: #7a8494;
  font-size: 24rpx;
}

.friendly-card {
  display: flex;
  gap: 22rpx;
}

.friendly-img {
  width: 210rpx;
  height: 220rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
}

.friendly-main {
  flex: 1;
  min-width: 0;
}

.friendly-title {
  font-size: 33rpx;
  font-weight: 800;
}

.orange {
  color: #d36b15;
  font-weight: 700;
}

.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 16rpx 0;
}

.chip {
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  background: #dff6e9;
  color: #168761;
  font-size: 22rpx;
}

.blue-chip {
  background: #e8f0ff;
  color: #2865c7;
}

.purple-chip {
  background: #f0e9ff;
  color: #7247bd;
}

.orange-chip {
  background: #fff0df;
  color: #c15b11;
}

.friendly-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.outline-btn,
.solid-btn {
  height: 70rpx;
  line-height: 70rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
}

.outline-btn {
  color: #168761;
  background: #ffffff;
  border: 1rpx solid #168761;
}

.solid-btn {
  color: #ffffff;
  background: #0f8b66;
}

.route-lite {
  background: #edf8f2;
  border-radius: 16rpx;
  padding: 20rpx;
}

.recommend {
  display: inline-flex;
  margin-right: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  background: #61c98c;
  color: #ffffff;
  font-size: 22rpx;
}

.route-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 20rpx 0;
  color: #6c7474;
  font-size: 22rpx;
}

.route-stats text {
  display: block;
  margin-top: 6rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.info-card {
  padding: 24rpx;
}

.small-line {
  margin-top: 16rpx;
  color: #344054;
  font-size: 23rpx;
  line-height: 1.45;
}

.risk-card {
  padding: 24rpx;
  border-color: #f0cba6;
  background: #fff7ee;
  color: #a84d0b;
  font-size: 25rpx;
  line-height: 1.5;
}

.risk-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}
