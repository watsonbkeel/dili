<view class="mh-page">
  <view class="mh-head">
    <view class="mh-title">轻松出行导览</view>
    <button class="mh-mode-switch" bindtap="changeMode">切换模式</button>
  </view>

  <view class="mh-status">
    <text class="mh-status-icon">✓</text>
    <view>已开启少步行与无障碍信息优先</view>
  </view>

  <view class="location-card">
    <view class="location-copy">
      <view class="location-main">当前位置：{{locationLabel}}</view>
      <view class="location-sub">{{locationSourceText}}｜更新于 {{locationUpdatedText}}</view>
    </view>
    <button class="refresh" bindtap="refreshLocation" loading="{{locating}}" disabled="{{locating}}">{{locating ? '定位中' : '刷新定位'}}</button>
  </view>

  <view class="mh-map-card">
    <map
      class="mh-map"
      latitude="{{location.lat}}"
      longitude="{{location.lng}}"
      markers="{{markers}}"
      scale="14"
      show-location="{{usingRealLocation}}"
      bindmarkertap="onMarkerTap"
    />
    <view class="mh-map-caption">点击地图标记可查看景点详情</view>
  </view>

  <view class="mh-feature-grid">
    <view class="mh-feature green" bindtap="openShortRoute">
      <view class="mh-feature-icon">少</view>
      <view class="mh-feature-title">找少步行路线</view>
      <view class="mh-feature-desc">附近与步行时长综合排序</view>
    </view>
    <view class="mh-feature blue" bindtap="openAccessiblePlaces">
      <view class="mh-feature-icon">♿</view>
      <view class="mh-feature-title">找无障碍景点</view>
      <view class="mh-feature-desc">优先完整无障碍通行</view>
    </view>
    <view class="mh-feature neutral" bindtap="openAi">
      <view class="mh-feature-icon">AI</view>
      <view class="mh-feature-title">规划轻松行程</view>
      <view class="mh-feature-desc">按你的需要生成路线</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="mh-state">正在根据位置整理景点...</view>
  <view wx:elif="{{error}}" class="mh-state error-state">
    <view>{{error}}</view>
    <button class="retry-btn" bindtap="refreshLocation">重新定位加载</button>
  </view>

  <view wx:else id="accessible-places" class="place-section">
    <view class="section-head">
      <view>
        <view class="section-title">无障碍友好景点</view>
        <view class="section-sub">按无障碍通行程度和距离排序</view>
      </view>
      <button class="section-more" bindtap="openAccessiblePlaces">{{showAccessiblePlaces ? '收起' : '查看更多'}}</button>
    </view>

    <view wx:if="{{!visibleAccessiblePlaces.length}}" class="mh-state">附近暂无已确认可使用轮椅游览的景点</view>
    <view class="place-list">
      <view class="place-card" wx:for="{{visibleAccessiblePlaces}}" wx:key="id">
        <image wx:if="{{item.coverUrl}}" class="place-image" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="place-main">
          <view class="place-title-row">
            <view class="place-name">{{item.name}}</view>
            <text class="access-badge {{item.accessibilityTone}}">{{item.accessibilityLabel}}</text>
          </view>
          <view class="place-meta">{{item.distanceText}} · {{item.walkingTimeText}}</view>
          <view class="place-summary">{{item.accessibilitySummary}}</view>
          <view class="place-actions">
            <button class="outline-btn" bindtap="openPlace" data-id="{{item.id}}">查看无障碍信息</button>
            <button class="solid-btn" bindtap="openNavigation" data-id="{{item.id}}">导航到这里</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && !error}}" id="short-routes" class="place-section">
    <view class="section-head">
      <view>
        <view class="section-title">少步行景点推荐</view>
        <view class="section-sub">综合当前位置距离与景区步行时长</view>
      </view>
      <button class="section-more" bindtap="openShortRoute">{{showShortWalkPlaces ? '收起' : '查看推荐'}}</button>
    </view>

    <view wx:if="{{!visibleShortWalkPlaces.length}}" class="mh-state">暂无可推荐的少步行景点</view>
    <view class="place-list">
      <view class="place-card" wx:for="{{visibleShortWalkPlaces}}" wx:key="id">
        <image wx:if="{{item.coverUrl}}" class="place-image" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="place-main">
          <view class="place-title-row">
            <view class="place-name">{{item.name}}</view>
            <text class="recommend-badge">推荐</text>
          </view>
          <view class="place-meta">{{item.distanceText}} · {{item.walkingTimeText}}</view>
          <view class="place-summary">{{item.summary}}</view>
          <view class="access-line">{{item.accessibilityLabel}}</view>
          <view class="place-actions">
            <button class="outline-btn" bindtap="openPlace" data-id="{{item.id}}">查看景点详情</button>
            <button class="solid-btn" bindtap="openNavigation" data-id="{{item.id}}">导航到这里</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="risk-band">
    <view class="risk-title">出行提示</view>
    <view>无障碍设施可能随开放区域、维护和客流情况变化，出发前请向景区确认。</view>
  </view>

  <view class="ai-float" bindtap="openAi">AI</view>
  <view class="bottom-nav">
    <view class="nav-item active" data-tab="home" bindtap="goTab"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item" data-tab="camera" bindtap="goTab"><view class="nav-icon">◉</view><view>拍照</view></view>
    <view class="nav-item" data-tab="routes" bindtap="goTab"><view class="nav-icon">⌘</view><view>路线</view></view>
    <view class="nav-item" data-tab="profile" bindtap="goTab"><view class="nav-icon">○</view><view>我的</view></view>
  </view>
</view>
