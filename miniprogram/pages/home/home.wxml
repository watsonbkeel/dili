<view class="page home-page">
  <view class="home-head">
    <view>
      <view class="title">本地历史导览</view>
      <view class="home-city">北京市 · 东城区</view>
    </view>
    <button class="ai-entry-btn" bindtap="openAi">AI 助手</button>
  </view>

  <view class="search-shell">
    <view class="search-icon">⌕</view>
    <input
      class="search-input"
      value="{{query}}"
      placeholder="搜索景点、人物、历史事件"
      confirm-type="search"
      bindinput="onQueryInput"
      bindconfirm="searchPlaces"
    />
    <button class="search-btn" bindtap="searchPlaces" loading="{{loading}}">搜索</button>
  </view>

  <view class="map-card">
    <view class="home-map">
      <view class="map-grid"></view>
      <view class="map-pin palace" bindtap="openPlaceByTap" data-id="beijing-palace-museum">
        <text></text>
        <view>故宫</view>
      </view>
      <view class="map-pin jingshan" bindtap="openPlaceByTap" data-id="jingshan-park">
        <text></text>
        <view>景山</view>
      </view>
      <view class="map-pin shichahai" bindtap="openPlaceByTap" data-id="shichahai">
        <text></text>
        <view>什刹海</view>
      </view>
    </view>
    <view class="map-caption">
      <text>附近历史点位</text>
      <text>什刹海 · 景山 · 故宫</text>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">推荐景点</view>
    <view class="section-link" bindtap="refreshPlaces">查看全部</view>
  </view>

  <view wx:if="{{loading}}" class="status">正在加载附近历史景点...</view>
  <view wx:elif="{{error}}" class="status">
    <view>{{error}}</view>
    <button class="btn primary" bindtap="refreshPlaces">重试</button>
  </view>
  <view wx:elif="{{!places.length}}" class="status">没有找到匹配的历史地点。</view>

  <view wx:else class="place-list">
    <block wx:for="{{places}}" wx:key="id">
      <view class="place-card" bindtap="openPlace" data-id="{{item.id}}">
        <view class="cover {{item.coverUrl ? '' : 'cover-empty'}}">
          <image wx:if="{{item.coverUrl}}" class="cover-img" mode="aspectFill" src="{{item.coverUrl}}" />
          <text wx:else>历史图片</text>
        </view>
        <view class="place-content">
          <view class="place-title-line">
            <view class="card-title">{{item.name}}</view>
            <text wx:if="{{item.distanceText}}" class="distance">{{item.distanceText}}</text>
          </view>
          <view class="tag-row">
            <block wx:for="{{item.displayTags}}" wx:for-item="tag" wx:key="*this">
              <text class="tag">{{tag}}</text>
            </block>
          </view>
          <view class="summary">{{item.summary}}</view>
        </view>
      </view>
    </block>
  </view>

  <view class="bottom-nav">
    <view class="nav-item active" data-tab="home" bindtap="goTab">
      <view class="nav-icon">⌂</view>
      <view>首页</view>
    </view>
    <view class="nav-item" data-tab="camera" bindtap="goTab">
      <view class="nav-icon">◉</view>
      <view>拍照</view>
    </view>
    <view class="nav-item" data-tab="routes" bindtap="goTab">
      <view class="nav-icon">⌘</view>
      <view>路线</view>
    </view>
    <view class="nav-item" data-tab="profile" bindtap="goTab">
      <view class="nav-icon">○</view>
      <view>我的</view>
    </view>
  </view>
</view>
