.home-page {
  background: #f7f6f1;
}

.home-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.home-city {
  margin-top: 12rpx;
  color: #1f6f68;
  font-size: 28rpx;
  font-weight: 700;
}

.ai-entry-btn {
  min-width: 144rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid #1f6f68;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f6f68;
  font-size: 25rpx;
}

.ai-entry-btn::after,
.search-btn::after {
  border: 0;
}

.search-shell {
  min-height: 88rpx;
  padding: 0 16rpx 0 24rpx;
  border: 1rpx solid #dbe4df;
  border-radius: 8rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.search-icon {
  color: #1f6f68;
  font-size: 32rpx;
  font-weight: 800;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  color: #1d2433;
  font-size: 28rpx;
}

.search-btn {
  width: 112rpx;
  height: 64rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #1f6f68;
  color: #ffffff;
  font-size: 25rpx;
}

.map-card {
  position: relative;
  margin-top: 22rpx;
  border: 1rpx solid #dbe4df;
  border-radius: 8rpx;
  overflow: hidden;
  background: #ffffff;
}

.home-map {
  width: 100%;
  height: 420rpx;
  background: #edf4f2;
  display: block;
}

.map-caption {
  min-height: 88rpx;
  padding: 14rpx 18rpx;
  background: #ffffff;
  color: #1d2433;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.map-caption-title {
  font-size: 25rpx;
  font-weight: 800;
}

.map-caption-sub {
  margin-top: 5rpx;
  color: #667085;
  font-size: 21rpx;
}

.location-refresh {
  min-width: 138rpx;
  height: 62rpx;
  line-height: 62rpx;
  margin: 0;
  padding: 0 14rpx;
  border: 1rpx solid #1f6f68;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f6f68;
  font-size: 24rpx;
  flex-shrink: 0;
}

.location-refresh::after {
  border: 0;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-title {
  color: #18212f;
  font-size: 34rpx;
  font-weight: 800;
}

.section-link {
  color: #1f6f68;
  font-size: 26rpx;
  font-weight: 700;
}

.place-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e1ded5;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.cover {
  width: 176rpx;
  height: 144rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #e8f1ee;
  color: #1f6f68;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.place-content {
  flex: 1;
  min-width: 0;
}

.place-title-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.place-title-line .card-title {
  flex: 1;
  min-width: 0;
}

.distance {
  color: #687386;
  font-size: 24rpx;
  flex-shrink: 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.summary {
  margin-top: 12rpx;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.48;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.status .btn {
  margin-top: 22rpx;
}
