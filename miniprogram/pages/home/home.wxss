.search-panel {
  margin-bottom: 20rpx;
  padding: 22rpx;
  border: 1rpx solid #e4e0d8;
  border-radius: 8rpx;
  background: #ffffff;
}

.city-row,
.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-row {
  margin-top: 18rpx;
}

.city-pill {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #edf4f2;
  color: #1f6f68;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border: 1rpx solid #c8d1dc;
  border-radius: 8rpx;
  background: #f9fafb;
  color: #1d2433;
  font-size: 28rpx;
  box-sizing: border-box;
}

.search-button {
  flex-shrink: 0;
}

.home-map {
  width: 100%;
  height: 430rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.map-toolbar {
  margin: 18rpx 0;
}

.place-card {
  display: flex;
  gap: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e4e0d8;
  border-radius: 8rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.cover {
  width: 160rpx;
  height: 132rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #edf4f2;
  color: #1f6f68;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.place-content {
  flex: 1;
  min-width: 0;
}

.tag-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  flex-wrap: wrap;
}

.distance {
  color: #667085;
  font-size: 24rpx;
}

.summary {
  margin-top: 10rpx;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.5;
}

.source-line {
  margin-top: 10rpx;
  color: #7a8494;
  font-size: 23rpx;
  line-height: 1.4;
}

.status .btn {
  margin-top: 24rpx;
}
