.home-page {
  background: #f7f6f1;
}

.home-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.home-city {
  margin-top: 12rpx;
  color: #1f6f68;
  font-size: 28rpx;
  font-weight: 700;
}

.ai-entry-btn {
  min-width: 144rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid #1f6f68;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1f6f68;
  font-size: 25rpx;
}

.ai-entry-btn::after,
.search-btn::after {
  border: 0;
}

.search-shell {
  min-height: 88rpx;
  padding: 0 16rpx 0 24rpx;
  border: 1rpx solid #dbe4df;
  border-radius: 8rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  gap: 14rpx;
  box-sizing: border-box;
}

.search-icon {
  color: #1f6f68;
  font-size: 32rpx;
  font-weight: 800;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  color: #1d2433;
  font-size: 28rpx;
}

.search-btn {
  width: 112rpx;
  height: 64rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0;
  border-radius: 8rpx;
  background: #1f6f68;
  color: #ffffff;
  font-size: 25rpx;
}

.map-card {
  position: relative;
  margin-top: 22rpx;
  border: 1rpx solid #dbe4df;
  border-radius: 8rpx;
  overflow: hidden;
  background: #ffffff;
}

.home-map {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: #edf4f2;
  overflow: hidden;
}

.map-grid {
  position: absolute;
  left: -40rpx;
  right: -40rpx;
  top: -40rpx;
  bottom: -40rpx;
  background:
    linear-gradient(90deg, rgba(31, 111, 104, 0.13) 1rpx, transparent 1rpx),
    linear-gradient(0deg, rgba(31, 111, 104, 0.13) 1rpx, transparent 1rpx);
  background-size: 80rpx 80rpx;
  transform: rotate(-8deg);
}

.map-pin {
  position: absolute;
  min-width: 112rpx;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #ffffff;
  border: 2rpx solid #1f6f68;
  color: #1f6f68;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 111, 104, 0.14);
}

.map-pin text {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
  background: #1f6f68;
  flex-shrink: 0;
}

.map-pin.palace {
  left: 46%;
  top: 44%;
}

.map-pin.jingshan {
  left: 38%;
  top: 26%;
}

.map-pin.shichahai {
  left: 15%;
  top: 34%;
}

.map-caption {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1d2433;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 0 18rpx;
}

.section-title {
  color: #18212f;
  font-size: 34rpx;
  font-weight: 800;
}

.section-link {
  color: #1f6f68;
  font-size: 26rpx;
  font-weight: 700;
}

.place-card {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e1ded5;
  border-radius: 8rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.cover {
  width: 176rpx;
  height: 144rpx;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #e8f1ee;
  color: #1f6f68;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.place-content {
  flex: 1;
  min-width: 0;
}

.place-title-line {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.place-title-line .card-title {
  flex: 1;
  min-width: 0;
}

.distance {
  color: #687386;
  font-size: 24rpx;
  flex-shrink: 0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.summary {
  margin-top: 12rpx;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.48;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.status .btn {
  margin-top: 22rpx;
}
