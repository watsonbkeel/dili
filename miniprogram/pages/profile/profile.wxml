<view class="page">
  <view class="topbar">
    <view>
      <view class="title">我的</view>
      <view class="subtitle">浏览历史、收藏与隐私说明。</view>
    </view>
  </view>

  <view class="card profile-card">
    <view class="avatar">旅</view>
    <view>
      <view class="card-title">本地访客</view>
      <view class="meta">{{userId}}</view>
    </view>
  </view>

  <view class="stats">
    <view class="stat-card">
      <view class="stat-num">{{favoriteCount}}</view>
      <view class="meta">收藏</view>
    </view>
    <view class="stat-card" bindtap="openHistory">
      <view class="stat-num">{{historyCount}}</view>
      <view class="meta">历史记录</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">设置</view>
    <view class="mode-setting" bindtap="changeMode">
      <view>
        <view class="mode-title">当前使用方式</view>
        <view class="meta">{{currentModeLabel}}</view>
      </view>
      <view class="mode-action">重新选择</view>
    </view>
    <view class="list-line" bindtap="openHistory">浏览历史</view>
    <view class="list-line">隐私说明：位置仅用于附近景点推荐，语音播报不采集用户声音。</view>
    <view class="list-line">关于产品：北京历史旅行导览第一版。</view>
  </view>

  <view class="ai-float" bindtap="openAi">AI</view>
  <view class="bottom-nav">
    <view class="nav-item" data-tab="home" bindtap="goTab"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item" data-tab="map" bindtap="goTab"><view class="nav-icon">◎</view><view>地图</view></view>
    <view class="nav-item" data-tab="routes" bindtap="goTab"><view class="nav-icon">⌘</view><view>路线</view></view>
    <view class="nav-item" data-tab="favorites" bindtap="goTab"><view class="nav-icon">♡</view><view>收藏</view></view>
    <view class="nav-item active" data-tab="profile" bindtap="goTab"><view class="nav-icon">○</view><view>我的</view></view>
  </view>
</view>
