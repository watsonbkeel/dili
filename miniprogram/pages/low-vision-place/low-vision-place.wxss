page {
  background: #ffffff;
}

.lv-detail-page {
  min-height: 100vh;
  padding-bottom: 300rpx;
  background: #ffffff;
  color: #000000;
  font-size: 46rpx;
  line-height: 1.65;
  box-sizing: border-box;
}

.lv-detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  background: #ffffff;
  border-bottom: 4rpx solid #000000;
  box-sizing: border-box;
}

.nav-placeholder {
  width: 100%;
}

.nav-row {
  height: 132rpx;
  padding: 0 28rpx;
  display: grid;
  grid-template-columns: 180rpx 1fr 180rpx;
  align-items: center;
  box-sizing: border-box;
}

.back-btn {
  width: 172rpx;
  height: 94rpx;
  min-height: 94rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
  font-size: 44rpx;
  line-height: 90rpx;
  font-weight: 900;
}

.back-btn::after,
.ask-ai-btn::after {
  border: 0;
}

.nav-title {
  text-align: center;
  font-size: 50rpx;
  line-height: 1.2;
  font-weight: 900;
}

.nav-spacer {
  width: 180rpx;
}

.detail-content {
  padding: 34rpx 32rpx 20rpx;
}

.plain-status {
  padding: 60rpx 0;
  font-size: 48rpx;
  line-height: 1.5;
  font-weight: 800;
}

.place-name {
  font-size: 72rpx;
  line-height: 1.2;
  font-weight: 900;
}

.speech-state,
.voice-status {
  margin-top: 18rpx;
  font-size: 40rpx;
  line-height: 1.55;
  font-weight: 800;
}

.text-section {
  padding: 32rpx 0;
  border-top: 4rpx solid #000000;
}

.place-name + .speech-state + .text-section {
  margin-top: 34rpx;
}

.section-title {
  font-size: 54rpx;
  line-height: 1.3;
  font-weight: 900;
}

.section-line {
  margin-top: 18rpx;
  font-size: 46rpx;
  line-height: 1.75;
  font-weight: 700;
}

.conversation-section {
  background: #ffffff;
}

.voice-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 4rpx solid #000000;
  background: #ffffff;
  box-sizing: border-box;
}

.voice-status {
  min-height: 56rpx;
  margin: 0 0 14rpx;
  text-align: center;
}

.ask-ai-btn {
  width: 100%;
  height: 112rpx;
  min-height: 112rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #000000;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 108rpx;
  font-weight: 900;
}

.ask-ai-btn.recording {
  background: #ffffff;
  color: #000000;
}

.ask-ai-btn[disabled] {
  background: #333333;
  color: #ffffff;
  opacity: 1;
}

.font-small {
  font-size: 40rpx;
}

.font-small .back-btn { font-size: 38rpx; }
.font-small .nav-title { font-size: 44rpx; }
.font-small .plain-status { font-size: 42rpx; }
.font-small .place-name { font-size: 62rpx; }
.font-small .speech-state,
.font-small .voice-status { font-size: 34rpx; }
.font-small .section-title { font-size: 48rpx; }
.font-small .section-line { font-size: 40rpx; }
.font-small .ask-ai-btn { font-size: 44rpx; }

.font-medium {
  font-size: 43rpx;
}

.font-medium .back-btn { font-size: 41rpx; }
.font-medium .nav-title { font-size: 47rpx; }
.font-medium .plain-status { font-size: 45rpx; }
.font-medium .place-name { font-size: 67rpx; }
.font-medium .speech-state,
.font-medium .voice-status { font-size: 37rpx; }
.font-medium .section-title { font-size: 51rpx; }
.font-medium .section-line { font-size: 43rpx; }
.font-medium .ask-ai-btn { font-size: 48rpx; }

.font-large {
  font-size: 46rpx;
}
