page {
  background: #ffffff;
}

.lv-detail-page {
  min-height: 100vh;
  padding-bottom: 230rpx;
  background: #ffffff;
  color: #000000;
  box-sizing: border-box;
}

.lv-detail-nav {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 30;
  background: #ffffff;
  border-bottom: 4rpx solid #000000;
  box-sizing: border-box;
}

.nav-placeholder {
  width: 100%;
}

.nav-row {
  height: 104rpx;
  padding: 0 28rpx;
  display: grid;
  grid-template-columns: 150rpx 1fr 150rpx;
  align-items: center;
  box-sizing: border-box;
}

.back-btn {
  width: 142rpx;
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #ffffff;
  color: #000000;
  font-size: 32rpx;
  line-height: 72rpx;
  font-weight: 900;
}

.back-btn::after,
.ask-ai-btn::after {
  border: 0;
}

.nav-title {
  text-align: center;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 900;
}

.nav-spacer {
  width: 150rpx;
}

.detail-content {
  padding: 34rpx 32rpx 20rpx;
}

.plain-status {
  padding: 60rpx 0;
  font-size: 38rpx;
  line-height: 1.5;
  font-weight: 800;
}

.place-name {
  font-size: 58rpx;
  line-height: 1.2;
  font-weight: 900;
}

.speech-state,
.voice-status {
  margin-top: 18rpx;
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: 800;
}

.text-section {
  padding: 32rpx 0;
  border-top: 4rpx solid #000000;
}

.place-name + .speech-state + .text-section {
  margin-top: 34rpx;
}

.section-title {
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 900;
}

.section-line {
  margin-top: 18rpx;
  font-size: 34rpx;
  line-height: 1.65;
  font-weight: 700;
}

.conversation-section {
  background: #ffffff;
}

.voice-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 18rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 4rpx solid #000000;
  background: #ffffff;
  box-sizing: border-box;
}

.voice-status {
  min-height: 44rpx;
  margin: 0 0 14rpx;
  text-align: center;
}

.ask-ai-btn {
  width: 100%;
  height: 96rpx;
  min-height: 96rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 4rpx solid #000000;
  border-radius: 8rpx;
  background: #000000;
  color: #ffffff;
  font-size: 42rpx;
  line-height: 92rpx;
  font-weight: 900;
}

.ask-ai-btn.recording {
  background: #ffffff;
  color: #000000;
}

.ask-ai-btn[disabled] {
  background: #333333;
  color: #ffffff;
  opacity: 1;
}
