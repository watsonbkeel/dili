.edit-page {
  background: #f7f6f1;
  padding-bottom: 80rpx;
}

.edit-card {
  padding: 28rpx;
  border: 1rpx solid #e1ded5;
  border-radius: 8rpx;
  background: #ffffff;
}

.avatar-picker {
  width: 128rpx;
  height: 128rpx;
  min-height: 128rpx;
  padding: 0;
  margin: 0 auto 28rpx;
  border-radius: 64rpx;
  overflow: hidden;
  background: #1f6f68;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-picker::after {
  border: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.form-label {
  margin: 24rpx 0 12rpx;
  color: #18212f;
  font-size: 28rpx;
  font-weight: 800;
}

.form-input {
  height: 82rpx;
  padding: 0 20rpx;
  border: 1rpx solid #c8d1dc;
  border-radius: 8rpx;
  background: #f9fafb;
  color: #18212f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.pref-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.pref-item {
  min-height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #ffffff;
  color: #1d2433;
  font-size: 27rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.save-btn {
  width: 100%;
  min-height: 92rpx;
  margin-top: 26rpx;
  border-radius: 8rpx;
  background: #1f6f68;
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 900;
}

.save-btn::after {
  border: 0;
}
