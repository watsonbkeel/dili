.detail-page {
  background: #f7f6f1;
}

.accessibility-panel {
  padding: 26rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #d39b36;
  border-radius: 8rpx;
  background: #fff8e8;
  color: #3f3018;
}

.accessibility-panel.full {
  border-color: #26956c;
  background: #eef9f4;
}

.accessibility-panel.none {
  border-color: #c76a5b;
  background: #fff3f0;
}

.accessibility-heading-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.accessibility-heading {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.accessibility-level {
  max-width: 310rpx;
  padding: 7rpx 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
  flex-shrink: 0;
}

.accessibility-summary {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.65;
}

.accessibility-route-state {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.accessibility-map-block {
  margin-top: 22rpx;
}

.accessibility-map-title {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  font-weight: 800;
}

.accessibility-map {
  width: 100%;
  border: 1rpx solid rgba(24, 33, 47, 0.18);
  border-radius: 6rpx;
  background: #ffffff;
  display: block;
}

.accessibility-disclaimer {
  margin-top: 16rpx;
  color: #6b5a3d;
  font-size: 23rpx;
  line-height: 1.55;
}

.hero {
  height: 430rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #e8f1ee;
  color: #1f6f68;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.detail-head {
  padding: 26rpx 0 10rpx;
}

.detail-meta {
  margin-top: 12rpx;
  color: #667085;
  font-size: 27rpx;
  line-height: 1.4;
}

.walking-note {
  margin-top: 6rpx;
  color: #7b8492;
  font-size: 23rpx;
  line-height: 1.45;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.muted-tag {
  background: #f2f4f7;
  color: #667085;
}

.audio-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  margin: 18rpx 0;
  border: 1rpx solid #d6e6e1;
  border-radius: 8rpx;
  background: #ffffff;
}

.audio-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  width: 240rpx;
  flex-shrink: 0;
}

.audio-actions .btn {
  min-height: 70rpx;
  font-size: 25rpx;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.primary-feature-grid {
  grid-template-columns: repeat(3, 1fr);
}

.feature-btn {
  min-height: 82rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  border: 1rpx solid #c9ded9;
  background: #ffffff;
  color: #1f6f68;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-btn::after {
  border: 0;
}

.favorite-action {
  gap: 8rpx;
  color: #667085;
  border-color: #d0d5dd;
}

.favorite-heart {
  color: #98a2b3;
  font-size: 34rpx;
  line-height: 1;
}

.favorite-action.favorite-active {
  color: #c62828;
  border-color: #efb7b7;
  background: #fff8f8;
}

.favorite-active .favorite-heart {
  color: #e53935;
}

.reaction-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.reaction-btn {
  min-height: 76rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  background: #f2f4f7;
  color: #667085;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.reaction-btn::after {
  border: 0;
}

.reaction-btn.selected {
  border-color: #2f6fed;
  background: #eaf1ff;
  color: #1857c9;
}

.reaction-count {
  min-width: 36rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.modal-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.42);
}

.route-sheet {
  width: 100%;
  max-height: 78vh;
  overflow-y: auto;
  padding: 18rpx 28rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 8rpx 8rpx 0 0;
  background: #ffffff;
  box-sizing: border-box;
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 22rpx;
  border-radius: 4rpx;
  background: #d0d5dd;
}

.sheet-title {
  color: #18212f;
  font-size: 36rpx;
  font-weight: 900;
}

.route-choice-list {
  display: grid;
  gap: 12rpx;
  margin-top: 22rpx;
}

.route-choice {
  min-height: 86rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.route-choice.selected {
  border-color: #2f6fed;
  background: #f3f7ff;
}

.route-choice-main {
  min-width: 0;
  flex: 1;
}

.route-choice-name {
  color: #18212f;
  font-size: 28rpx;
  font-weight: 800;
}

.route-choice-count {
  margin-top: 5rpx;
  color: #667085;
  font-size: 23rpx;
}

.create-route-toggle {
  width: 100%;
  min-height: 68rpx;
  line-height: 68rpx;
  margin-top: 18rpx;
  border: 1rpx solid #b8c6dd;
  border-radius: 8rpx;
  background: #ffffff;
  color: #2f6fed;
  font-size: 26rpx;
  font-weight: 800;
}

.create-route-toggle::after,
.create-route-btn::after {
  border: 0;
}

.create-route-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 190rpx;
  gap: 12rpx;
  margin-top: 14rpx;
}

.route-name-input {
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border: 1rpx solid #c8d1dc;
  border-radius: 8rpx;
  background: #f9fafb;
  font-size: 27rpx;
  box-sizing: border-box;
}

.create-route-btn {
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
  background: #2f6fed;
  color: #ffffff;
  font-size: 24rpx;
}

.sheet-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.body-text {
  margin-top: 14rpx;
  color: #344054;
  font-size: 28rpx;
  line-height: 1.75;
}

.list-line {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ece8df;
  color: #344054;
  font-size: 27rpx;
  line-height: 1.55;
}

.list-line:last-child {
  border-bottom: 0;
}

.action-bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin: 24rpx 0;
}

@media (max-width: 360px) {
  .primary-feature-grid {
    grid-template-columns: 1fr;
  }
}
