.hero {
  height: 320rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #edf4f2;
  color: #1f6f68;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
}

.detail-head {
  margin-top: 24rpx;
  margin-bottom: 14rpx;
}

.detail-head > view:first-child {
  min-width: 0;
  flex: 1;
}

.favorite-btn {
  width: 76rpx;
  height: 76rpx;
  min-height: 76rpx;
  padding: 0;
  border: 1rpx solid #c8d1dc;
  border-radius: 8rpx;
  background: #ffffff;
  color: #98a2b3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
  line-height: 1;
}

.favorite-btn::after {
  border: 0;
}

.favorite-btn.active {
  border-color: #f2b8b5;
  color: #e53935;
  background: #fff8f8;
}

.favorite-icon {
  font-size: 42rpx;
  line-height: 1;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.muted-tag {
  background: #f3f4f6;
  color: #667085;
}

.body-text {
  color: #344054;
  font-size: 27rpx;
  line-height: 1.65;
}

.timeline-row {
  display: flex;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #ece8df;
}

.timeline-row:last-child {
  border-bottom: 0;
}

.timeline-year {
  width: 100rpx;
  color: #1f6f68;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.timeline-event {
  flex: 1;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.55;
}

.list-line {
  padding: 12rpx 0;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.55;
  border-bottom: 1rpx solid #ece8df;
}

.list-line:last-child {
  border-bottom: 0;
}

.image-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
  padding: 16rpx 0;
}

.thumb {
  width: 144rpx;
  height: 108rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #edf4f2;
  color: #1f6f68;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 22rpx;
  flex-shrink: 0;
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.source-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #ece8df;
}

.source-item:last-child {
  border-bottom: 0;
}

.action-bar {
  margin: 24rpx 0;
}

.guide-card {
  background: #ffffff;
  border: 1rpx solid #d9e0e7;
  border-radius: 8rpx;
  padding: 28rpx;
  margin-bottom: 28rpx;
}

.story-body {
  margin-top: 18rpx;
  color: #1d2433;
  font-size: 28rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.section-title {
  margin-top: 24rpx;
  color: #18212f;
  font-size: 28rpx;
  font-weight: 700;
}

.disclaimer {
  margin-top: 24rpx;
  color: #7a8494;
  font-size: 24rpx;
  line-height: 1.5;
}
