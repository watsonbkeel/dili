<view class="page detail-page">
  <view wx:if="{{loading}}" class="status">正在加载地点资料...</view>

  <view wx:elif="{{error && !place}}" class="status">
    <view>{{error}}</view>
    <button class="btn primary" bindtap="loadPlace">重试</button>
  </view>

  <view wx:elif="{{place}}">
    <view wx:if="{{mode == 'mobility' && place.accessibility}}" class="accessibility-panel {{place.accessibility.tone}}">
      <view class="accessibility-heading-row">
        <view class="accessibility-heading">无障碍游览信息</view>
        <text class="accessibility-level">{{place.accessibility.label}}</text>
      </view>
      <view class="accessibility-summary">{{place.accessibility.summary}}</view>
      <view class="accessibility-route-state">
        {{place.accessibility.hasAccessibleRoute ? '已确认设有无障碍通道' : '暂未确认设有连续无障碍通道'}}
      </view>
      <view wx:if="{{place.accessibility.mapUrl}}" class="accessibility-map-block">
        <view class="accessibility-map-title">官方无障碍路线图（点击可放大）</view>
        <image class="accessibility-map" src="{{place.accessibility.mapUrl}}" mode="widthFix" bindtap="previewAccessibilityMap" />
      </view>
      <view class="accessibility-disclaimer">{{place.accessibility.disclaimer}}</view>
    </view>

    <view class="hero {{place.coverUrl ? '' : 'hero-empty'}}">
      <image wx:if="{{place.coverUrl}}" class="hero-img" mode="aspectFill" src="{{place.coverUrl}}" />
      <view wx:else>图片待补充</view>
    </view>

    <view class="detail-head">
      <view class="title">{{place.name}}</view>
      <view class="detail-meta">{{place.distanceText}} · {{place.walkingTimeText}}</view>
      <view wx:if="{{place.walkingTimeNote}}" class="walking-note">{{place.walkingTimeNote}}</view>
      <view class="tag-wrap">
        <block wx:for="{{place.category}}" wx:key="*this">
          <text class="tag">{{item}}</text>
        </block>
        <block wx:for="{{place.tags}}" wx:key="*this">
          <text class="tag muted-tag">{{item}}</text>
        </block>
      </view>
    </view>

    <view class="audio-card">
      <view>
        <view class="card-title">语音讲解</view>
        <view class="audio-state">{{audio.statusText}}</view>
      </view>
      <view class="audio-actions">
        <button class="btn primary" bindtap="toggleSummaryAudio" loading="{{audio.status == 'loading'}}">
          <text wx:if="{{audio.status == 'playing'}}">暂停</text>
          <text wx:elif="{{audio.status == 'paused'}}">继续</text>
          <text wx:else>播放历史讲解</text>
        </button>
      </view>
    </view>

    <view class="feature-grid primary-feature-grid">
      <button class="feature-btn favorite-action {{favorite ? 'favorite-active' : ''}}" bindtap="toggleFavorite" aria-label="{{favorite ? '取消收藏' : '收藏'}}">
        <text class="favorite-heart">♥</text>
        <text>{{favorite ? '已收藏' : '待收藏'}}</text>
      </button>
      <button class="feature-btn" bindtap="addToRoute">加入路线</button>
      <button class="feature-btn" open-type="share" bindtap="sharePlace">分享</button>
    </view>

    <view class="reaction-grid">
      <button class="reaction-btn {{reaction == 'recommend' ? 'selected' : ''}}" bindtap="recommendPlace" disabled="{{reactionBusy}}">
        <text>推荐</text><text class="reaction-count">{{reactionCounts.recommend}}</text>
      </button>
      <button class="reaction-btn {{reaction == 'notRecommend' ? 'selected' : ''}}" bindtap="rejectPlace" disabled="{{reactionBusy}}">
        <text>不推荐</text><text class="reaction-count">{{reactionCounts.notRecommend}}</text>
      </button>
    </view>

    <view class="card intro-card">
      <view class="card-title">历史简介</view>
      <view class="body-text">{{place.summary || '资料不足，待补充。'}}</view>
    </view>

    <view class="card">
      <view class="card-title">现场看什么</view>
      <block wx:for="{{place.highlights}}" wx:key="*this">
        <view class="list-line">{{item}}</view>
      </block>
      <view wx:if="{{!place.highlights.length}}" class="meta">建议观察建筑空间、地名和周边城市关系。</view>
    </view>

    <view class="card">
      <view class="card-title">游览提示</view>
      <block wx:for="{{place.visitTips}}" wx:key="*this">
        <view class="list-line">{{item}}</view>
      </block>
      <view wx:if="{{!place.visitTips.length}}" class="meta">建议以景区现场信息为准。</view>
    </view>

    <view class="toolbar action-bar">
      <button class="btn primary" bindtap="openNavigation">导航到这里</button>
      <button class="btn" bindtap="openAi">问 AI</button>
    </view>
  </view>

  <view wx:if="{{showRouteSheet}}" class="modal-mask" bindtap="closeRouteSheet">
    <view class="route-sheet" catchtap="noop">
      <view class="sheet-handle"></view>
      <view class="sheet-title">加入路线</view>
      <radio-group class="route-choice-list" bindchange="selectRoute">
        <label class="route-choice {{selectedRouteId == item.id ? 'selected' : ''}}" wx:for="{{routeOptions}}" wx:key="id">
          <radio value="{{item.id}}" checked="{{selectedRouteId == item.id}}" color="#2f6fed" />
          <view class="route-choice-main">
            <view class="route-choice-name">{{item.name}}</view>
            <view class="route-choice-count">{{item.stopCount}} 个景点</view>
          </view>
        </label>
      </radio-group>

      <button class="create-route-toggle" bindtap="toggleCreateRoute">＋ 新建路线</button>
      <view wx:if="{{creatingRoute}}" class="create-route-row">
        <input class="route-name-input" value="{{newRouteName}}" bindinput="onNewRouteName" placeholder="路线名称" maxlength="30" focus />
        <button class="create-route-btn" bindtap="createRoute">新建并选择</button>
      </view>

      <view class="sheet-actions">
        <button class="btn" bindtap="closeRouteSheet">取消</button>
        <button class="btn primary" bindtap="confirmAddToRoute">确认加入</button>
      </view>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item" data-tab="home" bindtap="goTab"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item" data-tab="camera" bindtap="goTab"><view class="nav-icon">◉</view><view>拍照</view></view>
    <view class="nav-item" data-tab="routes" bindtap="goTab"><view class="nav-icon">⌘</view><view>路线</view></view>
    <view class="nav-item" data-tab="profile" bindtap="goTab"><view class="nav-icon">○</view><view>我的</view></view>
  </view>
</view>
