.assistant-page {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(260rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #eef7f4;
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.robot {
  width: 94rpx;
  height: 94rpx;
  border: 1rpx solid #cfe1dc;
  border-radius: 47rpx;
  background: #ffffff;
  color: #15937f;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  font-weight: 800;
}

.context-band {
  padding: 22rpx 0;
  margin-bottom: 20rpx;
  border-top: 2rpx solid #15937f;
  border-bottom: 1rpx solid #bcd8d0;
}

.context-source {
  color: #11705f;
  font-size: 23rpx;
  font-weight: 700;
}

.context-title {
  margin-top: 8rpx;
  color: #18212f;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.context-description {
  margin-top: 10rpx;
  color: #52606f;
  font-size: 25rpx;
  line-height: 1.55;
}

.quick-panel {
  padding: 22rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #ffffff;
}

.quick-item {
  min-height: 68rpx;
  margin-top: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 6rpx;
  background: #f4f8f6;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.4;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.popular-title {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ef;
  color: #18212f;
  font-size: 29rpx;
  font-weight: 700;
}

.popular-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 14rpx;
}

.popular-item {
  min-height: 70rpx;
  padding: 8rpx;
  border: 1rpx solid #bcd8d0;
  border-radius: 6rpx;
  background: #ffffff;
  color: #11705f;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.25;
  display: flex;
  align-items: center;
  justify-content: center;
}

.popular-item::after,
.message-audio-btn::after,
.input-mode-toggle::after,
.voice-input-btn::after,
.send-btn::after {
  border: 0;
}

.chat-list {
  height: 46vh;
  min-height: 420rpx;
}

.message {
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
}

.message.user {
  align-items: flex-end;
}

.message.assistant {
  align-items: flex-start;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #253044;
  font-size: 27rpx;
  line-height: 1.65;
}

.message.user .bubble {
  background: #117c69;
  color: #ffffff;
}

.message-audio-btn {
  width: 86%;
  min-height: 76rpx;
  margin: 10rpx 0 0;
  padding: 8rpx 20rpx;
  border: 1rpx solid #117c69;
  border-radius: 6rpx;
  background: #117c69;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.message-audio-btn.is-playing {
  border-color: #b45309;
  background: #b45309;
}

.compact {
  margin: 12rpx 0;
}

.input-dock {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 14rpx;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 34rpx rgba(27, 64, 58, 0.14);
}

.input-mode-row {
  min-height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.input-mode-label {
  color: #52606f;
  font-size: 23rpx;
  font-weight: 700;
}

.input-mode-toggle {
  min-width: 176rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 14rpx;
  border: 1rpx solid #15937f;
  border-radius: 6rpx;
  background: #ffffff;
  color: #11705f;
  font-size: 23rpx;
}

.input-bar {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.chat-input {
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 6rpx;
  background: #f3f7f5;
  font-size: 27rpx;
  flex: 1;
}

.send-btn {
  width: 126rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 6rpx;
  background: #117c69;
  color: #ffffff;
  font-size: 26rpx;
}

.voice-input-row {
  display: grid;
  grid-template-columns: 180rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  margin-top: 10rpx;
}

.voice-input-btn {
  width: 180rpx;
  height: 76rpx;
  line-height: 76rpx;
  border: 1rpx solid #117c69;
  border-radius: 6rpx;
  background: #117c69;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.voice-input-btn.recording {
  border-color: #b42318;
  background: #b42318;
}

.voice-status {
  color: #52606f;
  font-size: 24rpx;
  line-height: 1.4;
}

@media (max-width: 360px) {
  .popular-grid {
    grid-template-columns: 1fr;
  }

  .voice-input-row {
    grid-template-columns: 1fr;
  }

  .voice-input-btn {
    width: 100%;
  }
}
