.assistant-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
  box-sizing: border-box;
  background: #eef7f4;
}

.assistant-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.robot {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: #ffffff;
  color: #15937f;
  border: 1rpx solid #cfe1dc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
}

.quick-panel {
  padding: 24rpx;
  background: #ffffff;
  border-radius: 8rpx;
  border: 1rpx solid #dbe4e0;
  margin-bottom: 20rpx;
}

.quick-item {
  margin-top: 14rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 8rpx;
  background: #f6f9f8;
  color: #344054;
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.popular-title {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #edf1ef;
  color: #18212f;
  font-size: 30rpx;
  font-weight: 700;
}

.popular-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 16rpx;
}

.popular-item {
  min-height: 112rpx;
  border-radius: 8rpx;
  background: #f6f9f8;
  border: 1rpx solid #dbe4e0;
  color: #15937f;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 12rpx;
  box-sizing: border-box;
}

.popular-name {
  font-size: 25rpx;
  font-weight: 700;
}

.chat-list {
  height: 52vh;
}

.message {
  margin-bottom: 18rpx;
  display: flex;
  flex-direction: column;
}

.message.user {
  align-items: flex-end;
}

.message.assistant {
  align-items: flex-start;
}

.bubble {
  max-width: 86%;
  padding: 20rpx 24rpx;
  border-radius: 8rpx;
  font-size: 27rpx;
  line-height: 1.65;
  background: #ffffff;
  color: #253044;
}

.message.user .bubble {
  background: #15937f;
  color: #ffffff;
}

.mini-btn {
  margin-top: 8rpx;
  margin-left: 0;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #15937f;
  border: 1rpx solid #cfe1dc;
  font-size: 23rpx;
}

.compact {
  margin: 12rpx 0;
}

.assistant-audio {
  margin: 10rpx 0 18rpx;
}

.input-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  display: flex;
  gap: 14rpx;
  padding: 14rpx;
  background: #ffffff;
  border: 1rpx solid #dbe4e0;
  border-radius: 8rpx;
  box-shadow: 0 12rpx 34rpx rgba(27, 64, 58, 0.12);
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  background: #f6f9f8;
  border-radius: 8rpx;
  font-size: 27rpx;
}

.send-btn {
  width: 132rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 8rpx;
  background: #15937f;
  color: #ffffff;
  font-size: 27rpx;
}
