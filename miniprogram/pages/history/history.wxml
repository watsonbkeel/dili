<view class="page">
  <view class="topbar">
    <view>
      <view class="title">浏览历史</view>
      <view class="subtitle">最近看过的景点按浏览时间排列。</view>
    </view>
  </view>

  <view wx:if="{{!history.length}}" class="status">暂无浏览记录。</view>

  <block wx:else>
    <block wx:for="{{history}}" wx:key="id">
      <view class="history-card" bindtap="openPlace" data-id="{{item.id}}">
        <view class="history-cover {{item.coverUrl ? '' : 'history-cover-empty'}}">
          <image wx:if="{{item.coverUrl}}" class="history-image" mode="aspectFill" src="{{item.coverUrl}}" />
          <text wx:else>历史</text>
        </view>
        <view class="history-main">
          <view class="card-title">{{item.name}}</view>
          <view class="meta">{{item.city}} · {{item.viewedText}}</view>
          <view class="preview">{{item.summary || item.address}}</view>
          <button class="remove-history" catchtap="remove" data-id="{{item.id}}">删除记录</button>
        </view>
      </view>
    </block>
  </block>
</view>
