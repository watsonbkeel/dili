<view class="page">
  <view class="topbar">
    <view>
      <view class="title">历史记录</view>
      <view class="subtitle">这里保存你生成过的导览故事，可随时删除。</view>
    </view>
  </view>

  <view class="toolbar">
    <button class="btn primary" bindtap="loadHistory" loading="{{loading}}">刷新</button>
  </view>

  <view wx:if="{{loading}}" class="status">正在加载历史记录...</view>
  <view wx:elif="{{error}}" class="status">{{error}}</view>
  <view wx:elif="{{!history.length}}" class="status">暂无历史记录。</view>

  <block wx:else>
    <block wx:for="{{history}}" wx:key="id">
      <view class="card">
        <view class="card-title">{{item.placeName}}</view>
        <view class="meta">{{item.address || '暂无地址'}} · {{item.createdText}}</view>
        <view class="preview">{{item.story.story}}</view>
        <view class="toolbar">
          <button class="btn" bindtap="reopen" data-index="{{index}}">查看</button>
          <button class="btn danger" bindtap="remove" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </block>
  </block>
</view>
