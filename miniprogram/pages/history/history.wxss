.history-card {
  display: flex;
  gap: 18rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid #e1ded5;
  border-radius: 8rpx;
  background: #ffffff;
}

.history-cover {
  width: 170rpx;
  height: 138rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #e8f1ee;
  color: #1f6f68;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.history-image {
  width: 100%;
  height: 100%;
}

.history-main {
  min-width: 0;
  flex: 1;
}

.preview {
  margin-top: 10rpx;
  color: #3c4658;
  font-size: 27rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.remove-history {
  width: auto;
  min-height: 54rpx;
  line-height: 54rpx;
  margin: 12rpx 0 0;
  padding: 0 16rpx;
  border: 1rpx solid #e0bbb7;
  border-radius: 8rpx;
  background: #ffffff;
  color: #b3261e;
  font-size: 23rpx;
}

.remove-history::after {
  border: 0;
}
