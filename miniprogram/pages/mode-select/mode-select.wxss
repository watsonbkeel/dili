.mode-page {
  min-height: 100vh;
  padding: 144rpx 40rpx 32rpx;
  box-sizing: border-box;
  background: #f9f6ee;
  color: #0f4428;
}

.mode-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 22rpx;
}

.brand-name {
  font-size: 28rpx;
}

.mode-title {
  font-size: 44rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.mode-subtitle {
  margin: 16rpx 0 30rpx;
  color: #4a4f4b;
  text-align: center;
  font-size: 25rpx;
  line-height: 1.4;
}

.mode-card {
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 36rpx rgba(42, 52, 43, 0.12);
}

.simple {
  min-height: 138rpx;
  padding: 22rpx 26rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.simple-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: #edf4ef;
  color: #0f5c34;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.normal-avatar {
  overflow: hidden;
  background: #ffffff;
}

.normal-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.mobility-icon-image {
  display: block;
  width: 58rpx;
  height: 58rpx;
}

.simple-main {
  flex: 1;
  min-width: 0;
}

.simple-title {
  font-size: 36rpx;
  font-weight: 800;
}

.simple-desc {
  margin-top: 8rpx;
  color: #5c625f;
  font-size: 23rpx;
  line-height: 1.4;
}

.arrow {
  font-size: 58rpx;
  color: #0f5c34;
}

.vision-card {
  margin-bottom: 20rpx;
  padding: 28rpx 30rpx;
  border-radius: 24rpx;
  background: #000000;
  color: #ffffff;
  border: 6rpx solid #ffffff;
  box-shadow: 0 16rpx 44rpx rgba(0, 0, 0, 0.18);
}

.vision-head {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.vision-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 46rpx;
  background: #ffffff;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  flex-shrink: 0;
}

.vision-title {
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 900;
}

.vision-features {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10rpx;
  margin: 22rpx 0 0;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #3b3b3b;
}

.vision-features > view {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
}

.feature-big {
  font-size: 40rpx;
  line-height: 1;
}

.vision-demo {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #000000;
}

.demo-label {
  font-size: 21rpx;
  font-weight: 700;
}

.demo-place {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 900;
}

.demo-btn {
  min-height: 64rpx;
  margin-top: 12rpx;
  border-radius: 10rpx;
  background: #000000;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 27rpx;
  font-weight: 800;
}

.voice-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 700;
}

.vision-choose {
  margin-top: 20rpx;
  min-height: 84rpx;
  border-radius: 42rpx;
  background: #ffffff;
  color: #000000;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  font-size: 36rpx;
  font-weight: 900;
}

.mode-footer {
  margin-top: 16rpx;
  text-align: center;
  color: #0f5c34;
  font-size: 25rpx;
  line-height: 1.35;
  white-space: nowrap;
}
