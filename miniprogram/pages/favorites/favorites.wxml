<view class="page">
  <view class="topbar">
    <view>
      <view class="title">我的收藏</view>
      <view class="subtitle">保存想再次查看的历史地点。</view>
    </view>
  </view>

  <view wx:if="{{!items.length}}" class="status">暂无收藏。可在景点详情页点击收藏。</view>

  <block wx:else>
    <block wx:for="{{items}}" wx:key="id">
      <view class="card">
        <view class="favorite-card-head">
          <view class="card-title">{{item.name}}</view>
          <button class="favorite-remove" bindtap="remove" data-id="{{item.id}}" aria-label="取消收藏">
            <text class="favorite-icon">♥</text>
          </button>
        </view>
        <view class="meta">{{item.address || '暂无地址'}} · {{item.savedText}}</view>
        <view class="meta">{{item.categoryText}}</view>
        <view class="preview">{{item.summary}}</view>
        <view class="toolbar">
          <button class="btn primary" bindtap="openPlace" data-id="{{item.id}}">查看</button>
        </view>
      </view>
    </block>
  </block>

  <view class="bottom-nav">
    <view class="nav-item" data-tab="home" bindtap="goTab"><view class="nav-icon">⌂</view><view>首页</view></view>
    <view class="nav-item" data-tab="map" bindtap="goTab"><view class="nav-icon">◎</view><view>地图</view></view>
    <view class="nav-item" data-tab="routes" bindtap="goTab"><view class="nav-icon">⌘</view><view>路线</view></view>
    <view class="nav-item active" data-tab="favorites" bindtap="goTab"><view class="nav-icon heart-active">♥</view><view>收藏</view></view>
    <view class="nav-item" data-tab="profile" bindtap="goTab"><view class="nav-icon">○</view><view>我的</view></view>
  </view>
</view>
