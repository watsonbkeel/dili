page {
  min-height: 100vh;
  background: #f6f4ef;
  color: #1d2433;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 150rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #16202a;
  line-height: 1.2;
}

.subtitle {
  margin-top: 10rpx;
  color: #596579;
  font-size: 26rpx;
  line-height: 1.5;
}

.toolbar {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.btn {
  min-height: 72rpx;
  padding: 0 28rpx;
  border-radius: 8rpx;
  border: 1rpx solid #c8d1dc;
  background: #ffffff;
  color: #1d2433;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn.primary {
  background: #1f6f68;
  border-color: #1f6f68;
  color: #ffffff;
}

.btn.danger {
  color: #b3261e;
  border-color: #e0bbb7;
}

.status {
  margin: 28rpx 0;
  padding: 28rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #596579;
  line-height: 1.6;
  border: 1rpx solid #e4e0d8;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e4e0d8;
  border-radius: 8rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #18212f;
  line-height: 1.35;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #667085;
  line-height: 1.45;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  background: #edf4f2;
  color: #1f6f68;
  font-size: 22rpx;
}

.bottom-nav {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 22rpx;
  z-index: 20;
  height: 104rpx;
  border-radius: 8rpx;
  border: 1rpx solid #dbe4e0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 34rpx rgba(27, 64, 58, 0.12);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
}

.nav-item {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 22rpx;
  gap: 6rpx;
}

.nav-icon {
  font-size: 34rpx;
  line-height: 1;
}

.nav-item.active {
  color: #15937f;
  font-weight: 700;
}

.ai-float {
  position: fixed;
  right: 34rpx;
  bottom: 150rpx;
  z-index: 25;
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #15937f;
  color: #ffffff;
  box-shadow: 0 14rpx 30rpx rgba(21, 147, 127, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
}

.audio-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.audio-state {
  color: #667085;
  font-size: 24rpx;
}

.btn.ghost {
  background: #f8faf9;
  color: #1f6f68;
  border-color: #c9ded9;
}

.btn.text-danger {
  color: #b3261e;
}
